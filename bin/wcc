#!/usr/bin/env python3
# wcc -- wrapper translating a Microsoft C 5.10 (CL.EXE) invocation to the
# open-source Open Watcom C compiler (wcc, 16-bit).
#
# MS CL form (as used by the Makefile):
#     cl "-AS -Od -Zp -I. -I..\H -c -FoX.OBJ X.C"
#
# Translation highlights:
#   -A{S,C,M,L,H}  memory model        -> -m{s,c,m,l,h}
#   -Od            no optimization     -> -od
#   -Zp[n]         struct packing      -> -zp[n] (default n=1)
#   -I<path>       include dir         -> -i=<path>  (\ -> /, DOS-absolute dropped)
#   -Fo<obj>       object output       -> -fo=<obj>
#   -D<m>[=v]      macro define        -> -d<m>[=v]
#   -c             compile only        -> dropped (wcc compiles to .obj)
# Always added:
#   -ecc           force __cdecl as the default calling convention, so wcc's
#                  code matches the MS C ABI the hand-written .ASM partners
#                  expect (stack params, caller cleanup, leading underscore).
#   -bt=dos        target 16-bit DOS.
#   -i=watcom/h    the vendored Open Watcom 16-bit headers (<stdio.h> etc.).
#   -zq            quiet (suppress the banner).

import os
import platform
import re
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
WATCOM_H = os.path.normpath(os.path.join(SCRIPT_DIR, "..", "watcom", "h"))

def wcc_bin():
    s, m = platform.system(), platform.machine()
    if s == "Darwin" and m == "arm64":
        return os.path.join(SCRIPT_DIR, "..", "watcom", "bin", "macos-arm64", "wcc")
    if s == "Linux" and m in ("x86_64", "amd64"):
        return os.path.join(SCRIPT_DIR, "..", "watcom", "bin", "linux-x64", "wcc")
    sys.exit(f"wcc: unsupported platform {s}-{m}")

MODEL = {"S": "-ms", "C": "-mc", "M": "-mm", "L": "-ml", "H": "-mh"}

def main():
    arg = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
    toks = arg.split()
    out = ["-ecc", "-bt=dos", "-s", "-zq", f"-i={WATCOM_H}"]
    source = None
    for t in toks:
        if t.startswith("-A") and len(t) == 3 and t[2] in MODEL:
            out.append(MODEL[t[2]])
        elif t == "-Od":
            out.append("-od")
        elif t.startswith("-Zp"):
            out.append("-zp" + (t[3:] or "1"))
        elif t.startswith("-I"):
            p = t[2:].replace("\\", "/")
            if not re.match(r"^[A-Za-z]:/", p):          # drop DOS-absolute (D:\...)
                out.append(f"-i={p}")
        elif t.startswith("-Fo"):
            out.append("-fo=" + t[3:].replace("\\", "/"))
        elif t.startswith("-D"):
            out.append("-d" + t[2:])
        elif t == "-c":
            pass                                          # implicit for wcc
        elif t.lower().endswith(".c"):
            source = t.replace("\\", "/")
        elif t.startswith("-"):
            pass                                          # ignore unknown MS-only flags
        else:
            source = t.replace("\\", "/")
    if not source:
        sys.exit("wcc: no C source file in command")
    out.append(source)
    sys.exit(subprocess.call([wcc_bin()] + out))

if __name__ == "__main__":
    main()
