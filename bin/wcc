#!/usr/bin/env python3

import os
import platform
import re
import subprocess
import sys
import tempfile

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
WATCOM_H = os.path.normpath(os.path.join(SCRIPT_DIR, "..", "watcom", "h"))

def wcc_bin():
    s, m = platform.system(), platform.machine()
    if s == "Darwin" and m == "arm64":
        return os.path.join(SCRIPT_DIR, "..", "watcom", "bin", "macos-arm64", "wcc")
    if s == "Linux" and m in ("x86_64", "amd64"):
        return os.path.join(SCRIPT_DIR, "..", "watcom", "bin", "linux-x64", "wcc")
    sys.exit(f"wcc: unsupported platform {s}-{m}")

MODEL = {"S": "-ms", "C": "-mc", "M": "-mm", "L": "-ml", "H": "-mh"}

def casefold_include_mirror(directory, mirror):
    """Expose both stored and case-folded header names in a temporary dir."""
    directory = os.path.abspath(directory)
    try:
        entries = os.listdir(directory)
    except OSError:
        return False
    os.makedirs(mirror, exist_ok=True)
    for entry in entries:
        source = os.path.join(directory, entry)
        if not os.path.isfile(source):
            continue
        for alias in (entry, entry.casefold()):
            target = os.path.join(mirror, alias)
            if not os.path.lexists(target):
                os.symlink(source, target)
    return True

def main():
    arg = (sys.argv[1] if len(sys.argv) > 1 else "").strip()
    toks = arg.split()
    out = ["-ecc", "-bt=dos", "-s", "-zq", f"-i={WATCOM_H}"]
    include_dirs = []
    source = None
    for t in toks:
        if t.startswith("-A") and len(t) == 3 and t[2] in MODEL:
            out.append(MODEL[t[2]])
        elif t == "-Od":
            out.append("-od")
        elif t == "-Os":
            out.append("-os")
        elif t.startswith("-Zp"):
            out.append("-zp" + (t[3:] or "1"))
        elif t.startswith("-I"):
            p = t[2:].replace("\\", "/")
            if not re.match(r"^[A-Za-z]:/", p):
                include_dirs.append(p)
        elif t.startswith("-Fo"):
            out.append("-fo=" + t[3:].replace("\\", "/"))
        elif t.startswith("-D"):
            out.append("-d" + t[2:])
        elif t == "-c":
            pass
        elif t == "-s":
            pass
        elif t in ("-2", "-zl"):
            out.append(t)
        elif t.lower().endswith(".c"):
            source = t.replace("\\", "/")
        elif t.startswith("-"):
            sys.exit(f"wcc: unsupported Microsoft C option: {t}")
        else:
            source = t.replace("\\", "/")
    if not source:
        sys.exit("wcc: no C source file in command")
    with tempfile.TemporaryDirectory(prefix="wcc-includes-") as temp:
        for index, directory in enumerate(include_dirs):
            mirror = os.path.join(temp, str(index))
            # Historical sources assume DOS-style case-insensitive include lookup.
            if casefold_include_mirror(directory, mirror):
                out.append(f"-i={mirror}")
            out.append(f"-i={directory}")
        out.append(source)
        rc = subprocess.call([wcc_bin()] + out)
    sys.exit(rc)

if __name__ == "__main__":
    main()
