#!/usr/bin/env python3
"""Native replacement for the MS-DOS NOSRVBLD message generator."""

from __future__ import annotations

import re
import sys
from collections import defaultdict
from pathlib import Path

from message_catalog import host_path, read_catalog


DIRECTIVE = re.compile(rb"^\s*:(class|def|use|end)\b(.*)$", re.IGNORECASE)
SEPARATOR = b";_______________________\r\n\r\n"


def fail(message: str) -> int:
    print(f"nosrvbld: {message}", file=sys.stderr)
    return 1


def main() -> int:
    args = sys.argv[1:]
    if len(args) == 1:
        args = args[0].split()
    if len(args) != 2:
        print("usage: nosrvbld SKELETON.SKL MESSAGES.MSG", file=sys.stderr)
        return 2

    skeleton = host_path(args[0])
    catalog = read_catalog(host_path(args[1]))
    default_pool = skeleton.stem.upper().encode("ascii")
    classes: dict[str, list[tuple[bytes, list[bytes]]]] = defaultdict(list)
    current_class: str | None = None

    for line in skeleton.read_bytes().splitlines():
        match = DIRECTIVE.match(line)
        if not match:
            continue
        directive = match.group(1).lower()
        fields = match.group(2).split()
        if directive == b"end":
            break
        if directive == b"class":
            if len(fields) != 1:
                return fail(f"invalid :class directive in {skeleton}")
            current_class = fields[0].decode("ascii")
            continue
        if current_class is None:
            return fail(f"message directive precedes :class in {skeleton}")

        if directive == b"def":
            if len(fields) < 2:
                return fail(f"invalid :def directive in {skeleton}")
            message_id, label = fields[0], fields[1]
            pool = default_pool
        else:
            if len(fields) < 3:
                return fail(f"invalid :use directive in {skeleton}")
            message_id, pool, label = fields[0], fields[1].upper(), fields[2]

        try:
            key = (pool, int(message_id, 10))
        except ValueError:
            return fail(f"invalid message id {message_id!r} in {skeleton}")
        payload = catalog.get(key)
        if payload is None:
            return fail(
                f"message {pool.decode('ascii')}:{int(message_id, 10):04d} not found"
            )
        classes[current_class].append((label, payload))

    stem = skeleton.stem
    for class_name, entries in classes.items():
        chunks = [f"; {stem}.cl{class_name} \r\n\r\n\r\n".encode("ascii")]
        for index, (label, payload) in enumerate(entries):
            if index:
                chunks.append(b"\r\n")
            chunks.extend((SEPARATOR, label, b" DB    ", payload[0], b"\r\n"))
            for continuation in payload[1:]:
                chunks.extend((b"\tDB   \t", continuation, b"\r\n"))
        Path(f"{stem}.CL{class_name}").write_bytes(b"".join(chunks))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
