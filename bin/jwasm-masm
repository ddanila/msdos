#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s)-$(uname -m)" in
    Darwin-arm64)  JWASM="$SCRIPT_DIR/../jwasm/macos-arm64/jwasm" ;;
    Linux-x86_64)  JWASM="$SCRIPT_DIR/../jwasm/linux-x64/jwasm" ;;
    *) echo "jwasm-masm: unsupported platform $(uname -s)-$(uname -m)" >&2; exit 1 ;;
esac
if [ ! -x "$JWASM" ]; then
    echo "jwasm-masm: JWasm binary not found at $JWASM (see jwasm/README.md to build)" >&2
    exit 1
fi

FLAGS="$1"
FILESPEC="$2"
FILESPEC="${FILESPEC%;}"
SOURCE="${FILESPEC%%,*}"
OUTPUT="${FILESPEC#*,}"

JFLAGS=()
for flag in $FLAGS; do
    case "$flag" in
        -Mx|-t)        ;;
        -I[A-Za-z]:\\*) ;;
        -I*)           f="${flag//\\//}"; JFLAGS+=("$f") ;;
        *)             JFLAGS+=("$flag") ;;
    esac
done

ORIG_DIR="$(pwd)"

case "$OUTPUT" in
    /*) ABS_OUTPUT="$OUTPUT" ;;
    *)  ABS_OUTPUT="$ORIG_DIR/$OUTPUT" ;;
esac

# JWasm silently ignores options after the source name, so output precedes it.
exec "$JWASM" -q -Zm -c "${JFLAGS[@]}" "-Fo$ABS_OUTPUT" "$SOURCE"
