#!/bin/bash
# Generic kvikdos runner.
# Usage: dos-run <DOS-tool-path> [args...]
#
# Mounts:
#   C: -> MS-DOS 4.0 source root (uppercase mode)
#   --cwd sets initial DOS current directory to the current Linux subdir
#
# This allows DOS relative paths like ..\INC to work correctly from
# any subdirectory of the source tree.

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Use kvikdos-soft (software CPU) when /dev/kvm is not available.
# Override with KVIKDOS env var for programs that need the software CPU
# even when KVM is present (e.g. XCOPY triggers #GP on KVM).
if [ -z "${KVIKDOS:-}" ]; then
    if [ -r /dev/kvm ] && [ -x "$SCRIPT_DIR/../kvikdos/kvikdos" ]; then
        KVIKDOS="$SCRIPT_DIR/../kvikdos/kvikdos"
    else
        KVIKDOS="$SCRIPT_DIR/../kvikdos/kvikdos-soft"
    fi
fi
KVIKDOS_ARGS=()
if [ "${KVIKDOS_AZZY:-0}" = 1 ]; then
    KVIKDOS_ARGS+=(--azzy)
fi
SRC_ROOT="$(cd "$SCRIPT_DIR/../MS-DOS/v4.0/src" && pwd)"

TOOL="$1"
shift

# The original DOS tools use fixed-name scratch files in shared mounted
# directories, so separate kvikdos processes are not safe to run concurrently.
# Serialize only this legacy-tool boundary; native JWasm/WLINK jobs remain
# fully parallel. mkdir is an atomic, portable lock on Linux and macOS.
LOCK_DIR="$SCRIPT_DIR/../.dos-run.lock"
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [ -f "$LOCK_DIR/pid" ]; then
        LOCK_PID="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
        if [[ "$LOCK_PID" =~ ^[0-9]+$ ]] && ! kill -0 "$LOCK_PID" 2>/dev/null; then
            rm -f "$LOCK_DIR/pid"
            rmdir "$LOCK_DIR" 2>/dev/null || true
            continue
        fi
    fi
    sleep 0.05
done
printf '%s\n' "$$" > "$LOCK_DIR/pid"
release_lock() {
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
}
trap release_lock EXIT HUP INT TERM

# Compute the DOS current directory (subdir relative to source root)
CWD="$(pwd)"
if [[ "$CWD" == "$SRC_ROOT"* ]]; then
    DOSREL="${CWD#$SRC_ROOT}"
    DOSREL="${DOSREL#/}"   # strip leading /
    DOSREL="${DOSREL//\//\\}" # convert / to backslash
    if [ -n "$DOSREL" ]; then
        CWD_ARG="--cwd=C:\\${DOSREL}\\"
    else
        CWD_ARG=""
    fi
else
    CWD_ARG=""
fi

"$KVIKDOS" \
    "${KVIKDOS_ARGS[@]}" \
    --dos-version=4 \
    --mount=c:"$SRC_ROOT"/ \
    --drive=c \
    $CWD_ARG \
    --env="PATH=c:\\TOOLS" \
    --env="INCLUDE=c:\\TOOLS\\BLD\\INC" \
    --env="LIB=c:\\TOOLS\\BLD\\LIB" \
    --env="INIT=c:\\TOOLS" \
    --env="COUNTRY=usa-ms" \
    --env="COMSPEC=c:\\CMD\\COMMAND\\COMMAND.COM" \
    "$TOOL" \
    "$@"
