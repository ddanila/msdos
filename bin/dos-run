#!/bin/bash

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
if [ -z "${KVIKDOS:-}" ]; then
    if [ -r /dev/kvm ] && [ -x "$SCRIPT_DIR/../kvikdos/kvikdos" ]; then
        KVIKDOS="$SCRIPT_DIR/../kvikdos/kvikdos"
    else
        KVIKDOS="$SCRIPT_DIR/../kvikdos/kvikdos-soft"
    fi
fi
KVIKDOS_ARGS=()
if [ "${KVIKDOS_AZZY:-0}" = 1 ]; then
    KVIKDOS_ARGS+=(--azzy)
fi
SRC_ROOT="$(cd "$SCRIPT_DIR/../src" && pwd)"

TOOL="$1"
shift

LOCK_DIR="$SCRIPT_DIR/../.dos-run.lock"
# Historical DOS tools reuse fixed scratch names, so only their emulator
# boundary is serialized; native build jobs remain parallel.
while ! mkdir "$LOCK_DIR" 2>/dev/null; do
    if [ -f "$LOCK_DIR/pid" ]; then
        LOCK_PID="$(sed -n '1p' "$LOCK_DIR/pid" 2>/dev/null || true)"
        if [[ "$LOCK_PID" =~ ^[0-9]+$ ]] && ! kill -0 "$LOCK_PID" 2>/dev/null; then
            rm -f "$LOCK_DIR/pid"
            rmdir "$LOCK_DIR" 2>/dev/null || true
            continue
        fi
    fi
    sleep 0.05
done
printf '%s\n' "$$" > "$LOCK_DIR/pid"
release_lock() {
    rm -f "$LOCK_DIR/pid"
    rmdir "$LOCK_DIR" 2>/dev/null || true
}
trap release_lock EXIT HUP INT TERM

CWD="$(pwd)"
if [[ "$CWD" == "$SRC_ROOT"* ]]; then
    DOSREL="${CWD#$SRC_ROOT}"
    DOSREL="${DOSREL#/}"
    DOSREL="${DOSREL//\//\\}"
    if [ -n "$DOSREL" ]; then
        CWD_ARG="--cwd=C:\\${DOSREL}\\"
    else
        CWD_ARG=""
    fi
else
    CWD_ARG=""
fi

"$KVIKDOS" \
    "${KVIKDOS_ARGS[@]}" \
    --dos-version=6.22 \
    --mount=c:"$SRC_ROOT"/ \
    --drive=c \
    $CWD_ARG \
    --env="PATH=c:\\TOOLS" \
    --env="INCLUDE=c:\\TOOLS\\BLD\\INC" \
    --env="LIB=c:\\TOOLS\\BLD\\LIB" \
    --env="INIT=c:\\TOOLS" \
    --env="COUNTRY=usa-ms" \
    --env="COMSPEC=c:\\CMD\\COMMAND\\COMMAND.COM" \
    "$TOOL" \
    "$@"
