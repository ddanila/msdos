#!/usr/bin/env python3
"""Minimal preprocessor for the JWasm assembler path.

JWasm (-Zm, MASM 5.1 mode) handles the STRUC.INC macro engine natively, so --
unlike bin/preprocess-wasm -- the ONLY transform needed is comma-separation of
structured-directive arguments. MASM 5.10 split macro-call args on whitespace;
JWasm (like wasm) splits on commas only, so:

    .IF   <model_byte EQ AT>     ->  .IF   <model_byte,EQ,AT>
    .FOR  BX = STDIN TO STDPRN   ->  .FOR  BX,=,STDIN,TO,STDPRN
    .IF   NZ AND                 ->  .IF   NZ,AND

The directive name keeps its dot (STRUC.INC frees the dotted names via
OPTION NOKEYWORD); no $-prefix rename, no $BuildJump expansion, no %out/listing
stripping, no reserved-word renames -- JWasm needs none of those.

Usage: preprocess-jwasm <outdir> <source.ASM> [incdir ...]
(Same shadow-directory interface as bin/preprocess-wasm, so bin/jwasm-masm can
drive it identically to how bin/wasm-masm drives preprocess-wasm.)
"""
import os, re, sys

# Extensions to preprocess in the source dir and include dirs.
INC_EXTS = {
    '.inc', '.asm', '.ctl', '.equ',
    '.cl1', '.cl2', '.cl3', '.cl4', '.cl5', '.cl6', '.cl7', '.cl8', '.cl9',
    '.cla', '.clb', '.clc', '.cld', '.cle',
}

# Structured-directive invocations whose args must be comma-separated.
# Exclude the macro DEFINITIONS (`.if macro ...`) via the negative lookahead.
STRUC_MACRO_PAT = re.compile(
    r'^('                              # group 1: leading prefix, preserved as-is
    r'[^\S\n]*'                        #   leading tabs/spaces only (NOT newlines,
                                       #   else blank lines before the directive
                                       #   would be eaten and dropped)
    r'(?:[A-Za-z_$@?][\w$@?]*:[^\S\n]*)?'  #  optional 'label:' on the same line
    r')\.'                             #   (e.g. `CUP:  .IF <...>`)
    r'((?:IF|ELSEIF|WHILE|UNTIL|WHEN|LEAVE|FOR)\b)'  # group 2: directive
    r'(?!\s+macro\b)'
    r'(.*?)$',                         # group 3: args
    re.MULTILINE | re.IGNORECASE,
)


def _comma_sep_struc_args(m):
    """Comma-separate the args of a structured-directive invocation.

    Keeps the leading dot (JWasm path) -- e.g. `.IF <ax EQ 0> THEN` becomes
    `.IF <ax,EQ,0>,THEN`. A trailing `;comment` is preserved verbatim.
    """
    prefix = m.group(1)           # leading whitespace + optional 'label:'
    keyword = m.group(2)          # IF, WHILE, FOR, ...
    rest = m.group(3)             # everything after the keyword
    comment_start = rest.find(';')
    if comment_start >= 0:
        args_part = rest[:comment_start]
        comment = rest[comment_start:]
    else:
        args_part = rest
        comment = ''

    # Convert spaces inside angle brackets to commas: <X OP Y> -> <X,OP,Y>.
    # Only at depth 1 (outermost brackets); nested <<WORD PTR X> NE 0> keeps
    # inner spaces intact (they are assembly operands, not macro args).
    # Leading/trailing whitespace inside < > is trimmed so we never emit a
    # blank macro arg (which MASM never produced, since it trims < > edges).
    def fix_angles(s):
        result = []
        depth = 0
        prev_was_space = False
        seen_content = False  # any non-space content in current depth-1 group?
        for ch in s:
            if ch == '<':
                depth += 1
                result.append(ch)
                prev_was_space = False
                if depth == 1:
                    seen_content = False
                else:
                    seen_content = True
            elif ch == '>':
                if depth == 1 and prev_was_space and result and result[-1] == ',':
                    result.pop()  # strip trailing-space comma we just emitted
                depth -= 1
                result.append(ch)
                prev_was_space = False
                if depth == 1:
                    seen_content = True
            elif ch == ' ' and depth == 1:
                if seen_content and not prev_was_space:
                    result.append(',')
                prev_was_space = True
            else:
                result.append(ch)
                prev_was_space = False
                if depth == 1:
                    seen_content = True
        return ''.join(result)

    args_part = fix_angles(args_part)

    # Convert remaining spaces between top-level args to commas, respecting
    # angle-bracket depth (so `<a,EQ,b> near AND` -> `<a,EQ,b>,near,AND`).
    tokens = []
    current = ''
    depth = 0
    for ch in args_part:
        if ch == '<':
            depth += 1
            current += ch
        elif ch == '>':
            depth -= 1
            current += ch
        elif (ch == ' ' or ch == '\t') and depth == 0:
            if current.strip():
                tokens.append(current.strip())
                current = ''
        else:
            current += ch
    if current.strip():
        tokens.append(current.strip())

    args_str = ','.join(tokens) if tokens else ''
    return f'{prefix}.{keyword}\t{args_str}{comment}'


def needs_transform(text):
    return STRUC_MACRO_PAT.search(text) is not None


def transform(text):
    return STRUC_MACRO_PAT.sub(_comma_sep_struc_args, text)


def process_file(src, dst):
    with open(src, 'rb') as f:
        raw = f.read()
    text = raw.decode('latin-1')      # CP437/latin-1: byte-preserving
    if needs_transform(text):
        raw = transform(text).encode('latin-1')
    with open(dst, 'wb') as f:
        f.write(raw)


def process_file_with_lower_alias(src, dstdir, entry):
    """Copy one DOS source and provide its case-folded include spelling.

    DOS and the original toolchain resolve include names case-insensitively.
    On Linux, JWasm delegates opening includes to the case-sensitive host
    filesystem, while the historical sources freely mix (for example)
    ``include macros.inc`` with a tracked ``MACROS.INC``.  Keep the original
    name and add a lowercase shadow alias where it is a distinct path.
    """
    dst = os.path.join(dstdir, entry)
    process_file(src, dst)
    lower_dst = os.path.join(dstdir, entry.lower())
    if lower_dst != dst and not os.path.exists(lower_dst):
        process_file(src, lower_dst)


def main():
    outdir = sys.argv[1]
    source = sys.argv[2]
    incdirs = sys.argv[3:]

    srcdir = os.path.dirname(source) or '.'
    process_file(source, os.path.join(outdir, os.path.basename(source)))
    for entry in os.listdir(srcdir):
        ext = os.path.splitext(entry)[1].lower()
        if ext in INC_EXTS and entry != os.path.basename(source):
            process_file_with_lower_alias(os.path.join(srcdir, entry), outdir, entry)

    srcdir_real = os.path.realpath(srcdir)
    for incdir in incdirs:
        if not os.path.isdir(incdir):
            continue
        if os.path.realpath(incdir) == srcdir_real:
            continue
        ppinc = os.path.join(outdir, 'inc_' + incdir.replace('/', '_').replace('.', '_').replace('=', '_'))
        os.makedirs(ppinc, exist_ok=True)
        for entry in os.listdir(incdir):
            ext = os.path.splitext(entry)[1].lower()
            if ext in INC_EXTS:
                process_file_with_lower_alias(os.path.join(incdir, entry), ppinc, entry)


if __name__ == '__main__':
    main()
