#!/usr/bin/env python3
"""Patch a DOS boot-sector BPB for a supported floppy image."""
import os
import struct
import sys

if len(sys.argv) != 2:
    print(f"Usage: {sys.argv[0]} <image>", file=sys.stderr)
    sys.exit(1)

geometries = {
    1200 * 1024: (224, 2400, 7, 15, 0xF9),
    1440 * 1024: (224, 2880, 9, 18, 0xF0),
    2880 * 1024: (240, 5760, 9, 36, 0xF0),
}

try:
    root_entries, total_sectors, sectors_per_fat, sectors_per_track, media = geometries[
        os.path.getsize(sys.argv[1])
    ]
except KeyError:
    print("Unsupported floppy image size", file=sys.stderr)
    sys.exit(1)

with open(sys.argv[1], 'r+b') as f:
    f.seek(11)
    f.write(struct.pack('<HBHBHHBHHHII',
        512,
        1,
        1,
        2,
        root_entries,
        total_sectors,
        media,
        sectors_per_fat,
        sectors_per_track,
        2,
        0,
        0,
    ))
    f.write(bytes([0x00, 0x00, 0x29]))
    f.write(struct.pack('<I', 0x19841984))
    f.write(b'MSDOS5     ')
    f.write(b'FAT12   ')
