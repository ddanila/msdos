#!/usr/bin/env python3
"""Patch the BPB in a DOS boot sector for a 1.44MB floppy (in-place, byte 11-61)."""
import struct, sys

if len(sys.argv) != 2:
    print(f"Usage: {sys.argv[0]} <image>", file=sys.stderr)
    sys.exit(1)

with open(sys.argv[1], 'r+b') as f:
    f.seek(11)
    f.write(struct.pack('<HBHBHHBHHHII',
        512,
        1,
        1,
        2,
        224,
        2880,
        0xF0,
        9,
        18,
        2,
        0,
        0,
    ))
    f.write(bytes([0x00, 0x00, 0x29]))
    f.write(struct.pack('<I', 0x19841984))
    f.write(b'MSDOS5     ')
    f.write(b'FAT12   ')
