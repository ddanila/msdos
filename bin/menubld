#!/usr/bin/env python3
"""Native replacement for the MS-DOS FDISK MENUBLD utility."""

from __future__ import annotations

import re
import sys
from pathlib import Path

from message_catalog import host_path, read_catalog


MARKER = re.compile(rb"\xE8([0-9]{4})")


def main() -> int:
    args = sys.argv[1:]
    if len(args) == 1:
        args = args[0].split()
    if len(args) != 2:
        print("usage: menubld FDISK.MSG MESSAGES.MSG", file=sys.stderr)
        return 2

    template = host_path(args[0])
    catalog = read_catalog(host_path(args[1]))

    def replace(match: re.Match[bytes]) -> bytes:
        message_id = int(match.group(1), 10)
        payload = catalog.get((b"FDISK", message_id))
        if payload is None:
            raise ValueError(f"FDISK message {message_id:04d} not found")
        if len(payload) != 1 or not re.fullmatch(rb'".*"', payload[0]):
            raise ValueError(f"FDISK message {message_id:04d} is not a C string")
        return payload[0][1:-1]

    try:
        output, replacements = MARKER.subn(replace, template.read_bytes())
    except ValueError as error:
        print(f"menubld: {error}", file=sys.stderr)
        return 1
    if replacements == 0:
        print(f"menubld: no message markers found in {template}", file=sys.stderr)
        return 1

    Path(f"{template.stem}M.C").write_bytes(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
