#!/usr/bin/env python3
"""Extract the COUNTRY.SYS payload assembled into MKCNTRY.EXE."""

from __future__ import annotations

import sys
from pathlib import Path


SIGNATURE = b"\xffCOUNTRY"
TRAILER = b"COUNTRY.SYS\0"


def extract(executable: bytes) -> bytes:
    start = executable.find(SIGNATURE)
    if start < 0:
        raise ValueError("COUNTRY data signature not found")
    end = executable.find(TRAILER, start + len(SIGNATURE))
    if end < 0:
        raise ValueError("COUNTRY data trailer not found")
    return executable[start:end]


def main(argv: list[str]) -> int:
    if len(argv) not in (1, 3):
        print("usage: mkcntry [MKCNTRY.EXE COUNTRY.SYS]", file=sys.stderr)
        return 2
    source = Path(argv[1] if len(argv) == 3 else "MKCNTRY.EXE")
    destination = Path(argv[2] if len(argv) == 3 else "COUNTRY.SYS")
    try:
        destination.write_bytes(extract(source.read_bytes()))
    except (OSError, ValueError) as error:
        print(f"mkcntry: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
