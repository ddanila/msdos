#!/usr/bin/env python3
"""Native replacement for SELECT's fixed-name run-length compressor."""

from __future__ import annotations

import sys
from pathlib import Path


ESCAPE = 0xFF
ESCAPED_BYTES = {0xFF: 0xFF, 0x0D: 0x01, 0x1A: 0x02}
RESERVED_COUNTS = {2, 0x0D, 0x1A, 0xFF}


def compress(source: bytes) -> bytes:
    output = bytearray()
    index = 0
    while index < len(source):
        value = source[index]
        end = index + 1
        while end < len(source) and source[end] == value and end - index < 0xFF:
            end += 1
        count = end - index
        if count in RESERVED_COUNTS:
            count -= 1
            end -= 1
        if count != 1:
            output += bytes((ESCAPE, count))
        if value in ESCAPED_BYTES:
            output += bytes((ESCAPE, ESCAPED_BYTES[value]))
        else:
            output.append(value)
        index = end
    return bytes(output)


def main(argv: list[str]) -> int:
    if len(argv) > 3:
        print("usage: compress [INPUT [OUTPUT]]", file=sys.stderr)
        return 2
    source = Path(argv[1] if len(argv) >= 2 else "SEL-PAN.DAT")
    destination = Path(argv[2] if len(argv) >= 3 else "SELECT.DAT")
    try:
        destination.write_bytes(compress(source.read_bytes()))
    except OSError as error:
        print(f"compress: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
