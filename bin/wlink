#!/usr/bin/env python3

import os
import platform
import re
import subprocess
import sys

SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
OPT_RE = r"(?:/\w+(?::[^\s+]+)?|(?<!\S)-\w+(?::[^\s+]+)?)"

SUPPORTED_OPTIONS = {
    "dosseg", "e", "ex", "exepack", "m", "map", "noe", "nofarcalls", "noi"
}

def validate_options(options):
    for option in options:
        normalized = option.lstrip("/-").lower()
        name = normalized.split(":", 1)[0]
        if name in SUPPORTED_OPTIONS:
            continue
        if name in ("cpa", "seg", "stack", "order", "packd", "packdata"):
            if ":" in normalized and normalized.split(":", 1)[1]:
                continue
        raise SystemExit(f"wlink: unsupported Microsoft LINK option: {option}")

def resolve_existing_casefold(path):
    """Resolve every component of a DOS-style path case-insensitively."""
    if os.path.exists(path):
        return path

    is_absolute = os.path.isabs(path)
    resolved = os.path.sep if is_absolute else ""
    for component in path.split(os.path.sep):
        if not component:
            continue
        if component in (".", ".."):
            resolved = os.path.join(resolved, component)
            continue
        # Resolve every component because DOS paths are case-insensitive while
        # response files often disagree with the host filesystem's spelling.
        search_dir = resolved or "."
        try:
            matches = [entry for entry in os.listdir(search_dir)
                       if entry.casefold() == component.casefold()]
        except OSError:
            return path
        if len(matches) != 1:
            return path
        resolved = os.path.join(resolved, matches[0])
    return resolved or path

def wlink_bin():
    s, m = platform.system(), platform.machine()
    if s == "Darwin" and m == "arm64":
        return os.path.join(SCRIPT_DIR, "..", "watcom", "bin", "macos-arm64", "wlink")
    if s == "Linux" and m in ("x86_64", "amd64"):
        return os.path.join(SCRIPT_DIR, "..", "watcom", "bin", "linux-x64", "wlink")
    sys.exit(f"wlink: unsupported platform {s}-{m}")

def names(field, ext):
    """Split an objects/libraries field into file names ('+' or whitespace
    separated), dropping /options, converting DOS backslashes, and appending
    the default extension when none is given (wlink's default obj ext is .o,
    but the build's files are .OBJ/.LIB)."""
    field = re.sub(OPT_RE, " ", field)
    out = []
    for it in re.split(r"[+\s]+", field.strip()):
        if not it:
            continue
        it = it.replace("\\", "/")
        if "." not in os.path.basename(it):
            it += ext
        out.append(it)
    return out

def main():
    arg = (sys.argv[1] if len(sys.argv) > 1 else "").strip()

    gopts = []
    mfile = re.search(r"@(\S+)", arg)
    if mfile:
        response_path = resolve_existing_casefold(mfile.group(1))
        with open(response_path, encoding="latin-1") as fh:
            body = fh.read()
        gopts += re.findall(OPT_RE, arg.replace("@" + mfile.group(1), " "))
    else:
        body = arg

    semi = body.find(";")
    if semi >= 0:
        gopts += re.findall(OPT_RE, body[semi + 1:])
        body = body[:semi]

    body = re.sub(r"\+\s*", "+", body)
    body = re.sub(r",[ \t]*\r?\n[ \t]*", ",", body)
    body = re.sub(r"[ \t]*\r?\n[ \t]*", ",", body)
    fields = [f.strip() for f in body.split(",")]
    while len(fields) < 4:
        fields.append("")
    objs_f, run_f, map_f, lib_f = fields[0], fields[1], fields[2], fields[3]

    gopts += re.findall(OPT_RE, run_f) + re.findall(OPT_RE, map_f)
    validate_options(gopts)
    gopts_l = [("/" + o[1:] if o.startswith("-") else o).lower() for o in gopts]

    order_classes = []
    for opt in gopts:
        match = re.fullmatch(r"[/-]order:([^\s]+)", opt, re.I)
        if match:
            order_classes = [name for name in match.group(1).split(",") if name]

    objs = [resolve_existing_casefold(path) for path in names(objs_f, ".obj")]
    libs = [resolve_existing_casefold(path) for path in names(lib_f, ".lib")]
    if not objs:
        sys.exit("wlink: no object modules in link command")

    run = re.sub(OPT_RE, "", run_f).strip().replace("\\", "/")
    if not run:
        run = os.path.splitext(os.path.basename(objs[0]))[0] + ".EXE"
    elif "." not in os.path.basename(run):
        run += ".EXE"

    run_dir, run_base = os.path.split(run)
    run = os.path.join(run_dir, run_base.upper()) if run_dir else run_base.upper()

    mapname = re.sub(OPT_RE, "", map_f).strip().replace("\\", "/")
    want_map = (mapname and mapname.lower() != "nul") or any(
        o in ("/m", "/map") for o in gopts_l
    )

    owroot = os.path.normpath(os.path.join(SCRIPT_DIR, "..", "watcom", "lib286"))
    owlib = os.path.join(owroot, "dos")
    directives = ["format", "dos", "option", "quiet"]
    # Microsoft LINK is case-insensitive unless /NOI requests significant case.
    directives += ["option", "caseexact" if "/noi" in gopts_l else "nocaseexact"]
    if any(option.lstrip("/-").lower() == "dosseg" for option in gopts):
        directives += ["option", "dosseg"]
    # WLINK's far-call shrinking changes offsets in self-referential resident code.
    directives += ["option", "nofarcalls"]
    # Floating-point companions live above the model-specific runtime directory.
    directives += ["libpath", owlib, "libpath", owroot]

    mstack = re.search(r"/stack:(\d+)", body, re.I)
    if mstack:
        directives += ["option", "stack=" + mstack.group(1)]

    mpackdata = next((re.fullmatch(r"[/-]packd(?:ata)?:(\d+)", opt, re.I)
                      for opt in gopts
                      if re.fullmatch(r"[/-]packd(?:ata)?:(\d+)", opt, re.I)), None)
    if mpackdata:
        # EMM386 treats logical far-data segments as distinct real-mode addresses.
        directives += ["option", "packdata=" + mpackdata.group(1)]

    if want_map:
        directives += ["option", "map" + (("=" + mapname) if mapname and mapname.lower() != "nul" else "")]
    directives += ["name", run]
    directives += ["file", ",".join(objs)]
    if libs:
        directives += ["library", ",".join(libs)]
    if order_classes:
        directives += ["order"]
        for class_name in order_classes:
            directives += ["clname", class_name]

    sys.exit(subprocess.call([wlink_bin()] + directives))

if __name__ == "__main__":
    main()
