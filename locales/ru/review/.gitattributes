# Preserve DOS serial captures byte-for-byte for the qualification hashes.
*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Installer console echo can emit repeated CR bytes before LF. Keep the
# raw captures (and their recorded hashes) instead of normalizing them.
install-*.log -text -whitespace

# Preserve emitted Qt diagnostics and unified-diff context bytes.
86box-exit-*.log -text -whitespace
86box-vnc-loopback.patch -text -whitespace

# Raw backend diagnostics retained for the probe ISA correction.
cpu8086-*.log -text -whitespace

# Preserve raw AT-84 backend diagnostics and DOS serial bytes.
at84-*.log -text -whitespace

# Preserve raw XT-83 backend diagnostics and DOS serial bytes.
xt83-*.log -text -whitespace

# Preserve raw legacy reload/rejection serial captures.
legacy-load-*.log -text -whitespace

# Preserve raw IBM AT country/NLS qualification logs.
country-286-*.log -text -whitespace
86box-unittester-exit.patch -text -whitespace

# Preserve raw IBM AT font qualification captures.
display-286-*.log -text -whitespace
86box-unittester-snapshot.patch -text -whitespace

# Preserve raw physical text-workflow serial captures.
text-*.log -text -whitespace

# Preserve filesystem and collation regression evidence byte-for-byte.
files-*.log -text -whitespace
