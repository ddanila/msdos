      "name": "4DOS 5.0 launches PKZIP 2.04g",
      "package": "4dos",
      "command": "4DOS.COM /C C:\\APPS\\PKZIP\\PKZIP.EXE -ex SMOKE.ZIP SAMPLE.TXT",
      "features": "one small child-process smoke: EXEC, shell swap-out/restore, allocation, file create/write/close",
      "expect": [
        "APP_RETURN_4dos-exec",
        "SAMPLE.TXT"
      ],
      "verify_zip": "SMOKE.ZIP"
    },
    {
      "id": "4dos6",
