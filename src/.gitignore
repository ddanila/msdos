
# Build output binaries — generated by make, no need to track
v4.0/src/CMD/**/*.EXE
v4.0/src/CMD/**/*.COM
v4.0/src/CMD/**/*.SYS
v4.0/src/CMD/**/*.BIN
v4.0/src/CMD/**/*.INC
v4.0/src/CMD/**/*.SKL
v4.0/src/CMD/**/*M.C

# DEV drivers
v4.0/src/DEV/**/*.SYS
v4.0/src/DEV/**/*.EXE

# BIOS outputs
v4.0/src/BIOS/*.SYS
v4.0/src/BIOS/*.EXE
v4.0/src/BIOS/*.BIN
v4.0/src/BIOS/*.COM

# BOOT outputs
v4.0/src/BOOT/*.BIN
v4.0/src/BOOT/*.EXE
v4.0/src/BOOT/*.INC

# DOS kernel outputs
v4.0/src/DOS/*.SYS
v4.0/src/DOS/*.EXE

# MEMM
v4.0/src/MEMM/**/*.SYS
v4.0/src/MEMM/**/*.EXE
v4.0/src/MEMM/**/*.LIB

# SELECT installer outputs
v4.0/src/SELECT/SELECT.EXE
v4.0/src/SELECT/SELECT.COM
v4.0/src/SELECT/SELECT.HLP
v4.0/src/SELECT/SELECT.DAT
v4.0/src/SELECT/SEL-PAN.*
v4.0/src/SELECT/PANEL.INF
v4.0/src/SELECT/SERVICES.*
v4.0/src/SELECT/SSTUB.EXE

# MESSAGES index
v4.0/src/MESSAGES/*.IDX

# MAPPER library
v4.0/src/MAPPER/MAPPER.LIB

# INC generated includes
v4.0/src/INC/boot.inc
v4.0/src/INC/0*

# EDLIN temporary/backup files
v4.0/src/**/*.$$$
v4.0/src/**/*.BAK

# Intermediate build artifacts
v4.0/src/**/*.OBJ
v4.0/src/**/*.MAP
v4.0/src/**/*.CTL
v4.0/src/**/*.CL?
v4.0/src/**/*.LST
v4.0/src/**/*.ERR
