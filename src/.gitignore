
# Build output binaries — generated by make, no need to track
CMD/**/*.EXE
CMD/**/*.COM
CMD/**/*.SYS
CMD/**/*.BIN
CMD/**/*.INC
!CMD/COMMAND/SHELLGATE.INC
CMD/**/*.SKL
CMD/**/*M.C

# DEV drivers
DEV/**/*.SYS
DEV/**/*.EXE
DEV/**/*.CPI

# BIOS outputs
BIOS/*.SYS
BIOS/*.EXE
BIOS/*.BIN
BIOS/*.COM

# BOOT outputs
BOOT/*.BIN
BOOT/*.EXE
BOOT/*.INC

# DOS kernel outputs
DOS/*.SYS
DOS/*.EXE

# MEMM
MEMM/**/*.SYS
MEMM/**/*.EXE
MEMM/**/*.LIB

# SELECT installer outputs
SELECT/SELECT.EXE
SELECT/SELECT.COM
SELECT/SELECT.HLP
SELECT/SELECT.DAT
SELECT/SEL-PAN.*
SELECT/PANEL.INF
SELECT/SERVICES.*
SELECT/SSTUB.EXE

# MESSAGES index
MESSAGES/*.IDX

# MAPPER library
MAPPER/MAPPER.LIB

# INC generated includes
INC/boot.inc
INC/0*

# EDLIN temporary/backup files
**/*.$$$
**/*.BAK

# Intermediate build artifacts
**/*.OBJ
**/*.MAP
**/*.CTL
**/*.CL?
**/*.LST
**/*.ERR
