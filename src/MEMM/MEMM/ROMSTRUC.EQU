ifndef INC_LIST
.xlist
endif

OPTION_ROM	STRUC
ROM_RECOGNITION	DW	?		; HOLDS 0AA55 WORD IF REAL OPTION ROM
ROM_LEN		DB	?		; BYTE HOLDING ROM SIZE / 512
ROM_ENTRY	DB	?		; WHERE CODE STARTS IN OPTION ROM
OPTION_ROM	ENDS

.list 	; end of ROMSTRUC.EQU
