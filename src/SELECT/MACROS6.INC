;;****************************************************************************				  ;
;;   CHECK_DOS_PATH:  Check to see if a path for the SET PATH command is valid				  ;
;;   SYNTAX:  CHECK_DOS_PATH	path_str								  ;
;;   INPUT:												  ;
;;	 path_str - An ASCII-N string containing the path to check.					  ;
;;   OUTPUT:												  ;
;;    If CY = 0, the path is valid.									  ;
;;    If CY = 1, The path is NOT valid: 								  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
CHECK_DOS_PATH	   MACRO     PATH_STR									  ;
    LEA  SI, PATH_STR											  ;
    CALL CHECK_DOS_PATH_ROUTINE 									  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   CHECK_PATH:  Check to see if a path is valid.							  ;
;;   SYNTAX:  CHECK_PATH    path_str, drive, root							  ;
;;   INPUT:												  ;
;;	 path_str - An ASCII-N string containing the path to check.					  ;
;;	 drive	  = 0: Drive letter cannot be specified.  (8 bit or immediate value)			  ;
;;		  = 1: Drive letter is optional and can be specified.					  ;
;;		  = 2: Drive letter must be specified.							  ;
;;	 root	  = 0: First non-drive character cannot be a backslash ('\') (8 bit or immediate value)   ;
;;		  = 1: First non-drive character may be a backslash ('\')                                 ;
;;		  = 2: First non-drive character must be a backslash ('\')                                ;
;; OUTPUT:												  ;
;;    If CY = 0, the path is valid.									  ;
;;    If CY = 1, The path is NOT valid: 								  ;
;;	   AX = 1, The drive specified is invalid.							  ;
;;	      = 2, There was no drive specified.							  ;
;;	      = 3, There was a drive specified. 							  ;
;;	      = 4, There was a leading backslash							  ;
;;	      = 5, The leading backslash was NOT present.						  ;
;;	      = 6, There was a trailing backslash.							  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
CHECK_PATH    MACRO	PATH_STR, DRIVE, ROOT								  ;
    LEA  SI, PATH_STR											  ;
    MOV  DI, SI 											  ;
    CALL POS_ZERO											  ;
    MOV  CX, [SI]											  ;
    ADD  SI, 2												  ;
    MOV  AL, DRIVE											  ;
    MOV  AH, ROOT											  ;
    CALL CHECK_VALID_PATH										  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   GET_NUMBER_PORTS: Get the number of parallel and serial ports attached				  ;
;;	      to the computer.										  ;
;;   SYNTAX:  GET_NUMBER_PORTS	 parallel, serial							  ;
;;   INPUT:												  ;
;;	 None.												  ;
;;   OUTPUT:												  ;
;;	 parallel = The number of parallel ports attached. (8 bit value)				  ;
;;	 serial   = The number of serial ports attached. (8 bit value)					  ;
;;   OPERATION: The macro performs a call to interrupt 11H to determine 				  ;
;;	 the number of ports available. 								  ;
;;****************************************************************************				  ;
GET_NUMBER_PORTS   MACRO     PARALLEL, SERIAL								  ;
    INT  11H					 ;; Determine equipment attached			  ;
    SHR  AH, 1					 ;; Put the number of serial ports in L.S. Bits 	  ;
    MOV  BH, 0												  ;
    MOV  BL, AH 											  ;
    MOV  SERIAL, BX											  ;
    AND  SERIAL, 0000000000000111B		 ;; Mask off the unwanted information			  ;
    MOV  CL, 5					 ;; Number of bits to shift				  ;
    SHR  AH, CL 				 ;; Put the number of parallel ports in L.S. Bits	  ;
    MOV  BL, AH 											  ;
    MOV  PARALLEL, BX				 ;; Store						  ;
    AND  PARALLEL, 0000000000000011B		 ;; Mask off the unwanted infromation			  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   CHANGE_ATTRIBUTE: Change the attributes on a group of file to be hidden				  ;
;;	      files.											  ;
;;   SYNTAX:  CHANGE_ATTRIBUTE	  list_ptr, num_files							  ;
;;   INPUT:												  ;
;;	 list_ptr = A pointer to a the list of files to change the attributes				  ;
;;		    of.  The list must be of the form:							  ;
;;			db   filename,?,?								  ;
;;		    Where the filename takes up 12 bytes.						  ;
;;	 num_file  = The number of files in the list.							  ;
;;   OUTPUT:												  ;
;;	 If CY = 1, there was an error encountered.							  ;
;;	 If CY = 0, there were no errors.								  ;
;;   OPERATION: The macro reads the attribute of the file, stores it in the				  ;
;;	 word following the filename in the list, and then assigns the new				  ;
;;	 attribute to the file. 									  ;
;;****************************************************************************				  ;
CHANGE_ATTRIBUTE   MACRO     LIST_PTR, NUM_FILES							  ;
    LEA  SI, LIST_PTR				 ;; Get the address of the file list			  ;
    MOV  AX, 0					 ;; Indicate we are to attach a new attribute to the file ;
    MOV  BX, NUM_FILES				 ;; Load the number of files in the list		  ;
    CALL CHANGE_ATTRIBUTE_ROUTINE		 ;; Change the attributes				  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   RESTORE_ATTRIBUTE: Restore the original attributes on a group of file.				  ;
;;   SYNTAX:  RESTORE_ATTRIBUTE  list_ptr, num_files							  ;
;;   INPUT:												  ;
;;	 list_ptr = A pointer to a the list of files to change the attributes				  ;
;;		    of.  The list must be of the form:							  ;
;;			db   filename,?,?								  ;
;;		    Where the filename takes up 12 bytes.						  ;
;;	 num_files = The number of files in the list.							  ;
;;   OUTPUT:												  ;
;;	 If CY = 1, there was an error encountered.							  ;
;;	 If CY = 0, there were no errors.								  ;
;;   OPERATION: This macros restores the attribute previously stored for the				  ;
;;	 listed files.											  ;
;;****************************************************************************				  ;
RESTORE_ATTRIBUTE   MACRO     LIST_PTR, NUM_FILES							  ;
    LEA  SI, LIST_PTR				 ;; Get the address of the file list			  ;
    MOV  AX, 1					 ;; Indicate we are to attach a new attribute to the file ;
    MOV  BX, NUM_FILES				 ;; Load the number of files in the list		  ;
    CALL CHANGE_ATTRIBUTE_ROUTINE		 ;; Change the attributes				  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   COMPARE_STRINGS:  Compare two strings.								  ;
;;   SYNTAX:  COMPARE_STRINGS	string_1, string_2							  ;
;;   INPUT:												  ;
;;	 string_1 = The address of the first string. (ASCII-N string)					  ;
;;	 string_2 = The address of the second string. (ASCII-N string)					  ;
;;   OUTPUT:												  ;
;;	 If CY = 1, the strings do no compare.								  ;
;;	 If CY = 0, the strings are the same.								  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
COMPARE_STRINGS    MACRO     STRING_1, STRING_2 							  ;
    LEA  SI, STRING_1											  ;
    LEA  DI, STRING_2											  ;
    CALL COMPARE_ROUTINE										  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   CHECK_WRITE_PROTECT  Determine if the diskette in drive A/B is write				  ;
;;			protected.									  ;
;;   SYNTAX:  CHECK_WRITE_PROTECT RET_CODE								  ;
;;   INPUT:												  ;
;;	 DRIVE = A_DRIVE (0) Check the diskette in the A drive						  ;
;;	 DRIVE = B_DRIVE (1) Check the diskette in the B drive						  ;
;;   OUTPUT:												  ;
;;	 If CY = 1, There was an error accessing the drive.						  ;
;;	 If CY = 0, There were no errors.								  ;
;;	 RET_CODE = 1: The diskette IS write protected. 						  ;
;;		  = 0: The diskette is NOT write protected.						  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
CHECK_WRITE_PROTECT	MACRO	  DRIVE, RET_CODE							  ;
    MOV  CX,DRIVE											  ;
    CALL CHECK_WRITE_ROUTINE										  ;
    MOV  RET_CODE, AX											  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   GET_FREE_SPACE  Determine the free disk space on a diskette.					  ;
;;   SYNTAX:  GET_FREE_SPACE   drive, space								  ;
;;   INPUT:												  ;
;;	 drive = 1: Examine diskette in drive A 							  ;
;;	       = 2: Examine diskette in drive B 							  ;
;;   OUTPUT:												  ;
;;	 If CY = 1, there was an error accessing the disk						  ;
;;	 If CY = 0, there were no errors.								  ;
;;	     space = The amount of free space on the disk (32-bit value)				  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
GET_FREE_SPACE	   MACRO     DRIVE, SPACE								  ;
    MOV  DL, DRIVE											  ;
    MOV  AH, 36H											  ;
    DOSCALL												  ;
    .IF < NC >												  ;
	 MUL  BX											  ;
	 MUL  CX											  ;
	 MOV  WORD PTR SPACE[0], AX									  ;
	 MOV  WORD PTR SPACE[2], DX									  ;
    .ENDIF												  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   MATCH_DISK_FILES  Determine if a list of file exist on a disk.					  ;
;;   SYNTAX:  GET_FREE_SPACE   path, file_list, list_type, num_files, ret_code				  ;
;;   INPUT:												  ;
;;	 path = ASCII-N string containing the drive, and path of where to				  ;
;;		search. 										  ;
;;	 file_list = The address of the list of files to use.  If AX=2, then				  ;
;;		     the first two bytes are ignored.							  ;
;;	 list_type = 1: Use a small list with 12 byte between filenames.				  ;
;;		   = 2: Use a list with 14 bytes between filenames.					  ;
;;   OUTPUT:												  ;
;;	 If CY = 1, There was an error accessing the disk.						  ;
;;	 If CY = 0, there were no errors.								  ;
;;	     ret_code = 1: All the files are on the disk.						  ;
;;	     ret_code = 0: All the file are NOT on the disk.						  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
MATCH_DISK_FILES   MACRO     PATH, FILE_LIST, LIST_TYPE, NUM_FILES, RET_CODE				  ;
    LEA  DI, PATH											  ;
    LEA  SI, FILE_LIST											  ;
    MOV  AX, LIST_TYPE											  ;
    MOV  CX, NUM_FILES											  ;
    CALL MATCH_FILES_ROUTINE										  ;
    MOV  RET_CODE, AX											  ;
    ENDM												  ;
INCLUDE  MACROS7.INC											  ;
