;;****************************************************************************				  ;
;;     Assembler MACROS for use with SELECT.								  ;
;;     File: MACROS6.INC										  ;
;; These macros define powerful assembler verbs neccessary for SELECT.					  ;
;; Note: Many of the macros make use of an ASCII-N string for passing					  ;
;;	 parameters.  The string is defined below.							  ;
;;		   DW  count										  ;
;;		   DB  "string_variable",?                                                                ;
;;	 COUNT is the length of the string and is a word.						  ;
;;	 It is necessary to follow the string with at least one byte for the				  ;
;;	 purpose of changing the ASCII-N string to an ASCII-Z string.					  ;
;;****************************************************************************				  ;
page					;;AN000;							  ;
;;****************************************************************************				  ;
;;   SCAN_PARAMETERS: Scan SELECT command line for parameters.						  ;
;;   SYNTAX:  SCAN_PARAMETERS	mode									  ;
;;   INPUT:												  ;
;;	 PSP command line										  ;
;;   OUTPUT:												  ;
;;	 mode	  = Install mode									  ;
;;		  = 0: Parameter is MENU								  ;
;;		  = 1: Parameter is FDISK								  ;
;;		  = 0FFH: Parameter is invalid								  ;
;;   OPERATION:  The SELECT command line is scanned for parameters.  The				  ;
;;	 return codes for the various parameters are provided in variables				  ;
;;	 defined above. 										  ;
;;  Note:												  ;
;;	 Before this macro is executed, there must be as ASSUME ES:DATA 				  ;
;;	 statement.  If not, the parser will not execute properly and					  ;
;;	 either the computer will hang or erroneous values will be returned.				  ;
;;****************************************************************************				  ;
SCAN_PARAMETERS    MACRO     MODE									  ;
    CALL SCAN_PARAMETERS_ROUTINE									  ;
    MOV  MODE, AX											  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   SCAN_INFO_FILE: Scan SELECT.TMP for parameters.							  ;
;;   SYNTAX:  SCAN_INFO_FILE   option_0, option_1, option_2, option_3, path, filename, buffer, buff_size		  ;;AC033;SEH add option_3 parameter
;;   INPUT:												  ;
;;	 filename  = The name of the file which contains the FDISK parameters.				  ;
;;		     (ASCII-N format)									  ;
;;	 buffer    = A buffer where the data read from the file can be stored.				  ;
;;	 buff_size = The size of the buffer.								  ;
;;   OUTPUT:												  ;
;;	 option_1 = 1											  ;
;;		  = 2											  ;
;;		  = 3											  ;
;;		  = 0FFh: Parameter is invalid (not 1, 2, 3)						  ;
;;	 option_2 = 1											  ;
;;		  = 2											  ;
;;		  = 0FFh: Parameter is invalid (not 1, 2)						  ;
;;	 option_3 = 1											  ;
;;		  = 2											  ;
;;		  = 0FFh: Parameter is invalid (not 1, 2)						  ;
;;	 path	  = Install path in ASCII-N format							  ;
;;   OPERATION: 											  ;
;;	 If the parameter on the command line is FDISK, then the					  ;
;;	 file specified in FILENAME is opened and additional parameters 				  ;
;;	 are read.  If the parameters in the file are invalid, or if the file				  ;
;;	 cannot be found, then 0FFh is returned in MODE and OPTION, and the				  ;
;;	 path length is set to zero.									  ;
;;****************************************************************************				  ;
SCAN_INFO_FILE	  MACRO     OPTION_0, OPTION_1, OPTION_2, OPTION_3, PATH, FILENAME, BUFFER, BUFF_SIZE
    MOV  AX, OFFSET PATH										  ;
    PUSH AX												  ;
    MOV  AX, OFFSET FILENAME										  ;
    PUSH AX												  ;
    MOV  AX, OFFSET BUFFER										  ;
    PUSH AX												  ;
    MOV  AX, BUFF_SIZE											  ;
    PUSH AX												  ;
    CALL SCAN_INFO_FILE_ROUTINE 									  ;
    mov  option_0, ax
    MOV  OPTION_1, BX											  ;
    MOV  OPTION_2, CX											  ;
    MOV  OPTION_3, DX											  ;;AN033;SEH return OPTION_3, also
    ENDM												  ;
;;****************************************************************************				  ;
;;   COPY_FILES:  Copy a list of files from the A diskette to either the B				  ;
;;	 or C drive.											  ;
;;   SYNTAX:  COPY_FILES target_disk, file_table, num_files, path					  ;
;;   INPUT:												  ;
;;	 target_disk = 1: Copy the files to the B drive 						  ;
;;		     = 2: Copy the files to the C drive 						  ;
;;	 path	     = The path where the files are to be copied if the 				  ;
;;		       destination is the hard disk.							  ;
;;	 file_table  = A table listing the files to copy.  It is of the 				  ;
;;		       following format.								  ;
;;		       db     filename									  ;
;;	      - The filename must be padded out to 12 characters.					  ;
;;	 num_files   = The number of files in the list. 						  ;
;;   OUTPUT:												  ;
;;	 None.												  ;
;;   OPERATION:  The files listed in the table are copied to the destination				  ;
;;	      from the A drive.  If the destination is C, then a path					  ;
;;	      path can be specified.									  ;
;;****************************************************************************				  ;
COPY_FILES    MACRO	DEST, FILE_TABLE, NUM_FILES							  ;
    MOV  AX, DEST											  ;
    MOV  BX, OFFSET FILE_TABLE										  ;
    MOV  CX, NUM_FILES											  ;
    CALL HOOK_INT_24		;AN000;JW								  ;
    CALL MOD_XCOPY											  ;
    CALL  RESTORE_INT_24	;AN000;JW								  ;
    ENDM												  ;
COPY_FILES2   MACRO	DEST, FILE_TABLE, NUM_FILES, PATH						  ;
    MOV  AX, DEST											  ;
    MOV  BX, OFFSET FILE_TABLE										  ;
    MOV  CX, NUM_FILES											  ;
    MOV  SI, OFFSET PATH										  ;
    CALL HOOK_INT_24		;AN000;JW								  ;
    CALL MOD_XCOPY											  ;
    CALL  RESTORE_INT_24	;AN000;JW								  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   INSTALL_FILES: Install the files from the original diskettes to the				  ;
;;	 startup and the operations diskette.								  ;
;;   SYNTAX:  INSTALL_FILES  source_disk, target_disk							  ;
;;   INPUT:												  ;
;;	 source_disk = 1: Read the files from the first diskette					  ;
;;		     = 2: Read the files from the second diskette					  ;
;;	 target_disk = 1: Copy the files to the start-up diskette					  ;
;;		     = 2: Copy the files to the operations diskette					  ;
;;		     = 3: Copy the files to the hard disk						  ;
;;   OUTPUT:												  ;
;;	 None.												  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
INSTALL_FILES MACRO	SOURCE_DISK, TARGET_DISK							  ;
    COPY_FILES	   SOURCE_DISK, TARGET_DISK, S_INSTALL_PATH, DOS_FILES, NUM_DOS_FILES			  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   GET_PRINTER_TITLES: Read the printer profile file and load the printer				  ;
;;	 names into a table.										  ;
;;   SYNTAX:  GET_PRINTER_TITLES   filename								  ;
;;   INPUT:												  ;
;;	 filename = A ASCII-N string containing the name of the file containing 			  ;
;;		    the printer profile.								  ;
;;   OUTPUT:												  ;
;;    If CY = 0, No error was encountered.  The following information is returned:			  ;
;;	 SEGMENT_LOCATION	= The segment where the printer names table is held ( 16 bit )		  ;
;;	 NAMES_TABLE_OFFSET	= The offset in the segment of the printer names table ( 16 bit )	  ;
;;	 LONGEST_NAME		= The longest printer name in the file ( 16 bit )			  ;
;;	 SIZE_NAMES_TABLE_ENTRY = The number of bytes between each printer name in the table (abs value ) ;
;;	 PRINTER_NAME_INDEX	= The number of names in the table. ( 16 bit )				  ;
;;    If CY = 1, An error was encountered.								  ;
;;	 BX - Contains an error number as defined below.						  ;
;;	 AX - Contains the DOS error number if the error listed in BX is a				  ;
;;	      file related error.									  ;
;;	 Error number			    Explaination.						  ;
;;	      1 	     There is not enough memory to build the names				  ;
;;			     table and provide a data buffer for reading the				  ;
;;			     file information.								  ;
;;	      2 	     There was an error opening the printer profile file.			  ;
;;			     AX contains the DOS error code.						  ;
;;	      3 	     There was an error reading the printer profile file.			  ;
;;			     AX contains the DOS error code.						  ;
;;	      4 	     The number at the beginning of the printer profile 			  ;
;;			     giving the number of definitions in the file was				  ;
;;			     either missing or was greater then 255.					  ;
;;	      5 	     A line in the printer profile file was found to				  ;
;;			     be longer then allowed in the buffer.					  ;
;;	      6 	     There was an error find a printer name in the file 			  ;
;;	      7 	     There was an error updating the file pointer				  ;
;;	      8 	     There are more then 255 printer definitions in the 			  ;
;;			     file.									  ;
;;	      9 	     The number of actual definitions in the printer profile			  ;
;;			     file did not agree with the number given at the				  ;
;;			     beginning of the file.							  ;
;;	     10 	     There was an error allocating the memory needed for			  ;
;;			     the data.									  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
GET_PRINTER_TITLES MACRO     FILENAME									  ;
    MOV  DI, OFFSET FILENAME	       ; The name of the printer definition file			  ;
    CALL GET_PRINTER_TITLES_ROUTINE    ; Subroutine to perform the function.				  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   GET_PRINTER_INFO:	Given the number of a printer, this routines retrieves				  ;
;;	 the information for this printer from the profile file.					  ;
;;   SYNTAX:  GET_PRINTER_INFO	 printer_num								  ;
;;   INPUT:												  ;
;;	 printer_num = The number the printer to get the information on.				  ;
;;		       The number is the location of this printer in the				  ;
;;		       printer names list.								  ;
;;   OUTPUT:												  ;
;;	 If CY = 0, there were no errors.								  ;
;;	 The following variable are updated with the information found in				  ;
;;	 the file:											  ;
;;	       I_PRINTER										  ;
;;	       N_PRINTER_TYPE										  ;
;;	       S_MODE_PARM										  ;
;;	       S_CP_DRIVER										  ;
;;	       S_CP_PREPARE										  ;
;;	       S_GRAPH_PARM										  ;
;;	 If CY = 1, There were errors encountered.							  ;
;;	      BX = An error code indicating the type of error that occured.				  ;
;;		 = 3  There was an error reading the file						  ;
;;		 = 7  There was a error accessing the file						  ;
;;		 = 11 A printer definition has either a CDP or a CPP					  ;
;;			Prefix, but BOTH were not present.						  ;
;;		 = 12 There was an error in the printer definition.					  ;
;;			- A line was found with an invalid prefix					  ;
;;		 If the error was a result of a DOS function, then					  ;
;;		 on return, AX will contain the DOS error code. 					  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
GET_PRINTER_INFO       MACRO	 VAR_PRT								  ;
    MOV  AX, VAR_PRT											  ;
    CALL GET_PRINTER_INFO_ROUTINE									  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   RELEASE_PRINTER_INFO: Close the printer profile file and free the					  ;
;;	 allocated memory.										  ;
;;   SYNTAX:  RELEASE_PRINTER_INFO									  ;
;;   INPUT:												  ;
;;	 None.												  ;
;;   OUTPUT:												  ;
;;	 If CY = 0, There were no error encountered.							  ;
;;	 If CY = 1, There was an error. 								  ;
;;	     AX = The DOS error code for the deallocate memory function 				  ;
;;   OPERATION: Closes the printer profile file and deallocted memory.					  ;
;;****************************************************************************				  ;
RELEASE_PRINTER_INFO	MACRO										  ;
    CALL RELEASE_PRINTER_INFO_ROUTINE									  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   GET_PRINTER_PARAMS: Get parameters for specified printer.						  ;
;;   SYNTAX:  GET_PRINTER_PARAMS  var_prt, var_port, var_status 					  ;
;;   INPUT:												  ;
;;	 var_prt  = The printer number. 								  ;
;;	 var_port = The number of the port to retrieve the information on.				  ;
;;		    If var_port = 0, the information that is returned is				  ;
;;		    that which cooresponds to var_prt.							  ;
;;	   var_port = 0 : Get the information on printer number VAR_PRT 				  ;
;;		    = 1 : Get the information for the printer attached to LPT1				  ;
;;		    = 2 : Get the information for the printer attached to LPT2				  ;
;;		    = 3 : Get the information for the printer attached to LPT3				  ;
;;		    = 4 : Get the information for the printer attached to COM1				  ;
;;		    = 5 : Get the information for the printer attached to COM2				  ;
;;		    = 6 : Get the information for the printer attached to COM3				  ;
;;		    = 7 : Get the information for the printer attached to COM4				  ;
;;   OUTPUT:												  ;
;;	 var_status = 1: Printer information is valid							  ;
;;		    = 0: Printer not valid: default values returned					  ;
;;   OPERATION: Printer information for the specified printer is returned.				  ;
;;	 If the specified printer is not defined, default values will be				  ;
;;	 returned.											  ;
;;	      I_PRINTER      = Index into printer list (16 bit variable) : default 1			  ;
;;	      N_PRINTER_TYPE = P: Parallel printer							  ;
;;			     = S: Serial printer							  ;
;;	      I_PORT	     = Port number	       (16 bit variable) : default 1			  ;
;;	      I_REDIRECT     = Redirection port number (16 bit variable) : default 1			  ;
;;	      S_MODE_PARM    = Mode parameters		   - ASCII-N format				  ;
;;	      S_CP_DRIVER    = Code page driver parameters - ASCII-N format				  ;
;;	      S_CP_PREPARE   = Code prepare parameters	   - ASCII-N format				  ;
;;	      S_GRAPH_PARM   = Graphics parameters	   - ASCII-N format				  ;
;;	 The structures of printer information are searched for the one with				  ;
;;	 the same number as specified by VAR_PRT.  If found, the information				  ;
;;	 in that structure is returned in the variables listed above.					  ;
;;****************************************************************************				  ;
GET_PRINTER_PARAMS MACRO     VAR_PRT, VAR_PORT, VAR_STATUS						  ;
    MOV  AX, VAR_PRT											  ;
    MOV  BX, VAR_PORT											  ;
    CALL GET_PRINTER_PARAMS_ROUTINE									  ;
    MOV  VAR_STATUS, AX 										  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   SAVE_PRINTER_PARAMS: Save the printer information in the printer structures			  ;
;;   SYNTAX:  SAVE_PRINTER_PARAMS  var_prt								  ;
;;   INPUT:												  ;
;;	 var_prt = The printer number.									  ;
;;   OUTPUT:												  ;
;;	 None.												  ;
;;   OPERATION: Printer information for the specified printer is stored.				  ;
;;	      I_PRINTER      = Index into printer list (16 bit variable) : default 1			  ;
;;	      N_PRINTER_TYPE = P: Parallel printer							  ;
;;			     = S: Serial printer							  ;
;;	      I_PORT	     = Port number	       (16 bit variable) : default 1			  ;
;;	      I_REDIRECT     = Redirection port number (16 bit variable) : default 1			  ;
;;	      S_MODE_PARM    = Mode parameters		   - ASCII-N format				  ;
;;	      S_CP_DRIVER    = Code page driver parameters - ASCII-N format				  ;
;;	      S_CP_PREPARE   = Code prepare parameters	   - ASCII-N format				  ;
;;	      S_GRAPH_PARM   = Graphics parameters	   - ASCII-N format				  ;
;;	 The information is stored in the structures according to the type				  ;
;;	 and port number of this printer.  The first three structures are for				  ;
;;	 LPT1 - LPT3, while the next four are for COM1 - COM2.						  ;
;;****************************************************************************				  ;
SAVE_PRINTER_PARAMS	MACRO	  VAR_PRT								  ;
    MOV  AX, VAR_PRT											  ;
    CALL SAVE_PRINTER_PARAMS_ROUTINE									  ;
    ENDM												  ;
;;****************************************************************************				  ;
;;   CHANGE_AUTOEXEC:  Search for the SELECT command in the autoexec.bat and				  ;
;;	 change the parameters for that line.								  ;
;;   SYNTAX:  CHANGE_AUTOEXEC	FILENAME, APPEND_STRING 						  ;
;;   INPUT:												  ;
;;	 FILENAME = An ASCII-N string containing the name of the file to change.			  ;
;;	      Since the string has to be converted into an ASCII-Z string,				  ;
;;	      an extra byte must always be available following the string.				  ;
;;	 APPEND_STRING = An ASCII-N string containing the parameters to add to				  ;
;;	      the SELECT command.									  ;
;;   OUTPUT:												  ;
;;	 None.												  ;
;;   OPERATION: 											  ;
;;****************************************************************************				  ;
CHANGE_AUTOEXEC    MACRO     FILENAME, APPEND_STRING							  ;
    MOV  DI, OFFSET FILENAME										  ;
    MOV  SI, OFFSET APPEND_STRING									  ;
    CALL CHANGE_AUTOEXEC_ROUTINE									  ;
    ENDM												  ;
