;DSKCPY_ERR	DB	  0
DSKCPY_EXIT	EQU	  1	  ;AN000;DT user chose to exit diskcopy

;DSKCPY_WHICH	DB
DSKCPY_TO_A_720 EQU	  0
DSKCPY_TO_A_360 EQU	  1
DSKCPY_TO_B	EQU	  2

;DSKCPY_OPTION	DB
SOURCE1 	EQU	 0
NO_SOURCE1	EQU	 1

NOCHECK 	EQU	  0
DISKCOPY_TO	MACRO	 WHERE,HOW,CHECK	     ;
		MOV  DSKCPY_WHICH,WHERE 	     ;
		MOV  DSKCPY_OPTION,HOW		     ;
		LEA  AX,CHECK			     ;
		MOV  DSKCPY_SOURCE,AX		     ;
		ENDM				     ;

NOPANEL 	EQU	  0			     ;
DISKCOPY_PANELS MACRO	 PANEL1, PANEL2, PANEL3      ;
		MOV	 DSKCPY_PAN1,PANEL1	     ;
		MOV	 DSKCPY_PAN2,PANEL2	     ;
		MOV	 DSKCPY_PAN3,PANEL3	     ;
		ENDM				     ;

INSERT_DISK	MACRO	 DSK_PANEL, SRCH_FILE	     ;
		MOV	 DISK_PANEL, DSK_PANEL	     ;
		LEA	 DI,SRCH_FILE		     ;
		MOV	 SEARCH_FILE, DI	     ;
		CALL	 INSERT_DISK_ROUTINE	     ;
		ENDM				     ;

HANDLE_FORMAT_ERROR MACRO			     ;
		LOCAL	FORERR1,FORERR2,FORERR3      ;
		CMP	SUB_ERROR,6		     ;
		JNE	FORERR1 		     ;
		MOV	AX,PAN_DRIVE_ERROR	     ;
		JMP	FORERR3 		     ;
FORERR1:	CMP	SUB_ERROR,7		     ;
		JNE	FORERR2 		     ;
		MOV	AX,PAN_WRITE_PROT	     ;
		JMP	FORERR3 		     ;
FORERR2:	MOV	AX,ERR_GENERAL		     ;
FORERR3:	HANDLE_ERROR AX,E_RETURN	     ;
		ENDM				     ;
